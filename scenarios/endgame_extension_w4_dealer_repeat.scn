# West 4 dealer repeat below 30,000 continues play (engine.md §5 step 4, §11).
# West 4, dealer 3, scores: 26000 25000 24000 25000.
# Exhaustive draw: only dealer Seat 3 is tenpai -> deltas: -1000 -1000 -1000 +3000.
# Post-round scores: 25000 24000 23000 28000.
# Dealer repeats (and is below 30000) -> per engine.md §5 step 4 ("If the dealer repeats otherwise,
# play continues"), the extension's last hand repeats: West 4 honba 1, dealer 3!

[meta]
name: endgame_extension_w4_dealer_repeat
title: West 4 dealer repeat below 30000 continues West 4 rather than ending
rules: mahjongsoul
source: engine.md §5 step 4, §11

[round]
game_length: south
wind: W
round: 4
honba: 0
sticks: 0
dealer: 3
scores: 26000 25000 24000 25000

[wall]
hand 0: 147m 258p 369s 1234z
hand 1: 258m 369p 147s 1235z
