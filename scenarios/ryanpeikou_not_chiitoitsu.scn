hand 1: 223344m 55667p 88s
hand 2: 158m 269p 147s 1235z
hand 3: 569m 139p 259s 2467z
dora: 1z
draws: 7p

[steps]
0 tsumogiri 7p
assert_legal 1: ron
window: 1=ron

