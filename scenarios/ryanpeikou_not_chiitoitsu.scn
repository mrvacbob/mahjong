# Ryanpeikou is scored as 4 sequences + pair (3 han, normal fu), NOT Chiitoitsu, and does not stack with Iipeikou
# (rules.md §4 item 4).
# Seat 1 holds 223344m 55667p 88s; Seat 0 discards 7p -> Seat 1 rons 7p!
#   - 234m 234m 567p 567p 88s: ryanpeikou (3) + pinfu (1, ryanmen 4p/7p) + tanyao (1) = 5 han 30 fu (Mangan)
#   - Does NOT score chiitoi or iipeikou!
#   - Non-dealer Mangan ron = 8000 from Seat 0.

[meta]
name: ryanpeikou_not_chiitoitsu
title: Ryanpeikou scores 4 sequences plus pair (3 han, 30 fu) rather than Chiitoitsu or Iipeikou
rules: mahjongsoul
source: rules.md §4.4

[round]
wind: E
round: 1
honba: 0
sticks: 0
dealer: 0
scores: 25000 25000 25000 25000

[wall]
