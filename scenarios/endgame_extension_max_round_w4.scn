# Game end: West 4 (extension max round) ends unconditionally when dealer does not repeat,
# even if nobody reached 30,000 (no North round) (engine.md §5 step 4, rules.md §1 extension_max_round).
# West 4, dealer=3, scores: 27000 25000 24000 24000.
# Seat 2 discards 7s -> Seat 1 rons (pinfu + tanyao = 2 han 30 fu = 2000).
# Post-round scores: 27000 27000 22000 24000.
# Nobody >= 30000, dealer does not repeat, next wind would be North -> game ends!
# Tie-break between Seat 0 (27000) and Seat 1 (27000): starting seat order -> Seat 0 is 1st, Seat 1 is 2nd.

[meta]
name: endgame_extension_max_round_w4
title: West 4 ends the game unconditionally when dealer does not repeat even below 30000
rules: mahjongsoul
source: engine.md §5 step 4, rules.md §1 (extension_max_round)

[round]
game_length: south
wind: W
round: 4
honba: 0
sticks: 0
dealer: 3
scores: 27000 25000 24000 24000

[wall]
hand 0: 1199m 1199p 1199s 5z
hand 1: 234m 678m 234p 56s 88p
hand 2: 7s 3344m 7744p 3344s
hand 3: 5566m 5566p 1122s 7z
dora: 1z
draws: 2z 3z 4z 6z

[steps]
3 tsumogiri 2z
0 tsumogiri 3z
1 tsumogiri 4z
2 discard 7s
window: 1=ron

[expect]
outcome: ron
winners: 1
win 1: han=2 fu=30 yaku=pinfu,tanyao
deltas: 0 2000 -2000 0
scores: 27000 27000 22000 24000
sticks: 0
honba: 0
dealer_repeats: false
game_ended: true
final_scores: 27000 27000 22000 24000
final_ranks: 0 1 3 2
events: start_kyoku, tsumo(3), dahai(3), tsumo(0), dahai(0), tsumo(1), dahai(1), tsumo(2), dahai(2), hora(1), end_kyoku, end_game
