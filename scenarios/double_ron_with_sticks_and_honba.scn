# Double ron with riichi sticks and honba on the table (engine.md §4.1 row 1, §4.2, rules.md §4.21, §5.2).
# Round starts with honba=2 (600 on ron), sticks=1 (1000 on table), dealer=0.
# Seat 1 discards 7s; Seat 2 (closest CCW from Seat 1) and Seat 0 (dealer) both ron!
# - Seat 2 (non-dealer, West): 234m 678m 234p 56s 88p + ron 7s
#   pinfu (1) + tanyao (1) = 2 han 30 fu = 2000 + 600 (2 honba) = 2600 from Seat 1,
#   PLUS 1000 riichi stick from table -> +3600 total!
# - Seat 0 (dealer, East): 234m 567m 234p 56s 66p + ron 7s
#   pinfu (1) + tanyao (1) = 2 han 30 fu = 2900 from Seat 1 (NO honba, NO stick!).
# - Seat 1 pays 2600 + 2900 = 5500.
# - Because dealer (Seat 0) is among the winners, dealer repeats and honba becomes 2 + 1 = 3.

[meta]
name: double_ron_with_sticks_and_honba
title: Double ron gives sticks and honba only to closest CCW winner and repeats dealer
rules: mahjongsoul
source: engine.md §4.1 row 1, §4.2, rules.md §1, §4.21, §5.2
unverified: rules.md §5 item 2 (Mahjong Soul multi-ron honba to closest CCW only)

[round]
wind: E
round: 1
honba: 2
sticks: 1
dealer: 0
scores: 25000 25000 25000 24000

[wall]
hand 0: 234m 567m 234p 56s 66p
hand 1: 7s 1199m 1199p 1199s
hand 2: 234m 678m 234p 56s 88p
hand 3: 3344m 7788p 2233s 6z
dora: 1z
draws: 2z 3z

[steps]
0 tsumogiri 2z
1 discard 7s
assert_legal 2: ron
assert_legal 0: ron
window: 2=ron, 0=ron

[expect]
outcome: ron
winners: 2, 0
win 2: han=2 fu=30 yaku=pinfu,tanyao
win 0: han=2 fu=30 yaku=pinfu,tanyao
deltas: 2900 -5500 3600 0
scores: 27900 19500 28600 24000
sticks: 0
honba: 3
dealer_repeats: true
events: start_kyoku, tsumo(0), dahai(0), tsumo(1), dahai(1), hora(2), hora(0), end_kyoku
