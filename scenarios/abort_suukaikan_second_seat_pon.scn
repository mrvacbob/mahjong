abort_reason: suukaikan
deltas: 0 0 0 0
scores: 25000 25000 25000 25000
sticks: 0
honba: 1
dealer_repeats: true
events: start_kyoku, tsumo(0), ankan(0), dora(2z), tsumo(0), ankan(0), dora(3z), tsumo(0), ankan(0), dora(4z), tsumo(0), dahai(0), tsumo(1), ankan(1), dora(7z), tsumo(1), dahai(1), ryukyoku(suukaikan), end_kyoku
