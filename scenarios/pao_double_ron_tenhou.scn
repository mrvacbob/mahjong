# Tenhou counterpart: Pao inside a double ron (engine.md §4.2 Pao, Multi-ron, rules.md §1, §4.21, §4.31).
# Honba: 1, sticks: 1 (1000 on table).
# Seat 1 pons 5z (from S0), 6z (from S3), 7z (from S2 -> sets Daisangen pao on Seat 2).
# Seat 3 (3rd party) discards 7s -> BOTH Seat 0 (closest CCW, dealer) AND Seat 1 (Daisangen pao) ron 7s!
# Winners in CCW order from Seat 3: 0, 1.
# - Seat 0 (dealer, closest CCW): 234m 678m 234p 56s 88p + ron 7s -> pinfu (1) + tanyao (1) = 2 han 30 fu = 2900
#   + 300 honba (closest CCW) + 1000 stick (closest CCW) = +4200 (Seat 3 pays 3200; table stick 1000).
# - Seat 1 (non-dealer, Daisangen pao on Seat 2): 32000 split 50/50 between discarder Seat 3 (16000)
#   and liable Seat 2 (16000). Honba already went to closest CCW winner Seat 0!
#   (Seat 1 gets +32000; Seat 2 pays 16000; Seat 3 pays 16000 + 3200 = 19200.)
# Deltas: +4200, +32000, -16000, -19200 (sum = +1000, sticks 1 -> 0, point conservation holds!).
# Dealer (Seat 0) is a winner -> dealer_repeats: true, honba: 2.

[meta]
name: pao_double_ron_tenhou
title: Tenhou pao inside a double ron splits the pao yakuman while closest winner takes stick and honba
rules: tenhou
source: engine.md §4.2, rules.md §1, §4.21, §4.31

[round]
wind: E
round: 1
honba: 1
sticks: 1
dealer: 0
scores: 25000 25000 25000 25000

[wall]
hand 0: 234m 678m 234p 56s 88p
hand 1: 55z 66z 77z 56s 88p 9m 9p 9s
hand 2: 7z 258m 369p 14s 1234z
hand 3: 6z 7s 369m 147p 25s 123z
dora: 1z
draws: 5z 1m 2p 3p 4p 3m

[steps]
0 tsumogiri 5z
window: 1=pon:55z
1 discard 9m
2 tsumogiri 1m
3 discard 6z
window: 1=pon:66z
1 discard 9p
2 discard 7z
window: 1=pon:77z
1 discard 9s
2 tsumogiri 4p
3 discard 7s
assert_legal 0: ron
assert_legal 1: ron
window: 0=ron, 1=ron

[expect]
outcome: ron
winners: 0, 1
win 0: han=2 fu=30 yaku=pinfu,tanyao
win 1: yakuman=1 yaku=daisangen:1
deltas: 4200 32000 -16000 -19200
scores: 29200 57000 9000 5800
sticks: 0
honba: 2
dealer_repeats: true
events_order: pon(1), pon(1), pon(1), dahai(3), hora(0), hora(1), end_kyoku
