# Last-tile discard (0 live tiles remaining):
# - No ankan allowed on the last live draw (Seat 1 holds 4x 3z).
# - Discard with 0 live tiles left cannot be called (pon/chi/daiminkan illegal),
#   but CAN be ronned (Houtei Raoyui).
# Scoring for Seat 0 (dealer, East):
#   Hand: 234m 678m 234p 56s 88p + ron 7s (last-tile discard)
#   Yaku: pinfu (1) + tanyao (1) + houtei (1) = 3 han.
#   Dora indicator 1z -> dora 2z (0 dora).
#   Fu: 20 base + 10 menzen ron = 30 fu.
#   Dealer ron 3 han 30 fu = 5800 from Seat 1.

[meta]
name: last_tile_houtei_no_calls
title: Last-tile discard forbids kan and calls, allows Houtei ron
rules: mahjongsoul
source: engine.md §4.1 row 8, §4.2, rules.md §4.18, §4.19

[round]
wind: E
round: 1
honba: 0
sticks: 0
dealer: 0
scores: 25000 25000 25000 25000

[wall]
hand 0: 234m 678m 234p 56s 88p
hand 1: 333z 7s 111p 999p 111s
hand 2: 56s 1199m 5566p 223s
hand 3: 77s 3344m 77p 44p 344s
dora: 1z
draw_at 69: 3z

[steps]
auto_tsumogiri 69
# Seat 1 just drew 4th 3z with 0 live tiles left -> ankan illegal!
assert_illegal 1: ankan:3z
1 discard 7s
# 0 live tiles left: Seat 2 cannot chi, Seat 3 cannot pon, Seat 0 can ron (Houtei)!
assert_illegal 2: chi
assert_illegal 3: pon
assert_not_asked 2
assert_not_asked 3
assert_legal 0: ron
window: 0=ron

[expect]
outcome: ron
winners: 0
win 0: han=3 fu=30 yaku=houtei,pinfu,tanyao
deltas: 5800 -5800 0 0
scores: 30800 19200 25000 25000
sticks: 0
honba: 0
dealer_repeats: true
events_order: dahai(1), hora(0), end_kyoku
