# Four winds (Suufon Renda): all 4 seats discard the same wind (1z) on their
# first unbroken go-around (engine.md §4.1 row 2, §4.2, rules.md §1).
# Abortive draw: deltas 0 0 0 0, sticks 0, honba +1, dealer repeats.

[meta]
name: abort_suufon_renda
title: Four identical winds on the first unbroken go-around abort the round
rules: mahjongsoul
source: engine.md §4.1 row 2, §4.2, rules.md §1

[round]
wind: E
round: 1
honba: 0
sticks: 0
dealer: 0
scores: 25000 25000 25000 25000

[wall]
hand 0: 1z 234m 678m 234p 678p
hand 1: 1z 123m 789m 123p 789p
hand 2: 1z 234s 678s 123s 789s
hand 3: 1z 456m 456p 456s 55m 6z
dora: 7z
draws: 2z 3z 4z 5z

[steps]
0 discard 1z
window: 1=pass, 2=pass
1 discard 1z
2 discard 1z
3 discard 1z

[expect]
outcome: abortive_draw
abort_reason: suufon_renda
deltas: 0 0 0 0
scores: 25000 25000 25000 25000
sticks: 0
honba: 1
dealer_repeats: true
events: start_kyoku, tsumo(0), dahai(0), tsumo(1), dahai(1), tsumo(2), dahai(2), tsumo(3), dahai(3), ryukyoku(suufon_renda), end_kyoku
