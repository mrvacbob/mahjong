# Pao inside a double ron (engine.md §4.2, rules.md §4.21, §4.31).
# Round starts with honba=1 (300 on ron), sticks=1 (1000 on table), dealer=0.
# Seat 2 feeds 3rd dragon (7z) to Seat 1 (Pao on Daisangen against Seat 2).
# Later Seat 3 discards 4m -> BOTH Seat 0 (dealer, closest CCW from Seat 3) AND Seat 1 ron!
# - Seat 0 (closest CCW, dealer): 23m 678m 234p 567s 88p + ron 4m
#   pinfu (1) + tanyao (1) = 2 han 30 fu = 2900 + 300 (honba from Seat 3) + 1000 (stick from table) = +4200.
# - Seat 1 (non-dealer, Daisangen, NOT closest CCW so no honba/stick):
#   32000 split 50/50 between discarder Seat 3 (-16000) and liable Seat 2 (-16000) -> +32000.
# - Seat 3 pays 3200 + 16000 = -19200; Seat 2 pays -16000.
# - Dealer (Seat 0) won -> dealer repeats, honba becomes 1 + 1 = 2.

[meta]
name: pao_double_ron
title: Pao inside a double ron splits only the pao winner's yakuman with the liable seat
rules: mahjongsoul
source: engine.md §4.2, rules.md §4.21, §4.31; real-log campaign, docs/notes/p3-reallogs.md

[round]
wind: E
round: 1
honba: 1
sticks: 1
dealer: 0
scores: 25000 25000 25000 24000

[wall]
hand 0: 5z 6z 23m 678m 234p 567s
hand 1: 55z 66z 77z 23m 66p 1z 9m 1s
hand 2: 7z 1199m 5577p 2233s
hand 3: 4m 3355m 1199p 3344s
dora: 1z
draws: 8p 2z 2z 8p 3z 3z 4z

[steps]
# Turn 1: Seat 0 draws 8p, discards 5z -> Seat 1 pons 5z, discards 1z.
0 discard 5z
window: 1=pon:55z
1 discard 1z
2 tsumogiri 2z
3 tsumogiri 2z
# Turn 2: Seat 0 draws 8p (completing pair 88p), discards 6z -> Seat 1 pons 6z, discards 9m.
0 discard 6z
window: 1=pon:66z
1 discard 9m
window: 2=pass
2 discard 7z
window: 1=pon:77z
1 discard 1s
window: 2=pass
2 tsumogiri 3z
3 discard 4m
window: 0=ron, 1=ron

[expect]
outcome: ron
winners: 0, 1
win 0: han=2 fu=30 yaku=pinfu,tanyao
win 1: yakuman=1 yaku=daisangen
deltas: 4200 32000 -16000 -19200
scores: 29200 57000 9000 4800
sticks: 0
honba: 2
dealer_repeats: true
events_order: pon(1), pon(1), pon(1), dahai(3), hora(0), hora(1), end_kyoku
