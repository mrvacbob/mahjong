# Post-open-kan riichi ron whose ura dora count changes with the owed kan dora indicator
# (engine.md §4.2 Kan transactions, rules.md §1 kan_dora_daiminkan_timing, §4.17, §5 item 4).
# Seat 0 declares double riichi and discards 5z (dora: 1z, 2z -> 0 dora; ura: 1z, 7p -> ura[1] is 8p!).
# Seat 1 calls daiminkan on 5z (reach_accepted(0) first, cancelling ippatsu; owes kan dora #1 = 2z).
# Seat 1 draws rinshan 7s and discards 7s -> Seat 0 (holding two 8p!) rons 7s!
# Scoring for Seat 0 (dealer, East):
#   Hand: 234m 678m 234p 56s 88p + ron 7s
#   - Mahjong Soul (default): owed kan dora #1 is NOT revealed before ron, so only 1 ura indicator (1z) applies:
#     double_riichi (2) + pinfu (1) + tanyao (1) = 4 han 30 fu -> Dealer ron = 11600!
#   - Tenhou: owed kan dora #1 IS revealed at the discard, so 2 ura indicators (1z, 7p -> ura 8p x2!) apply:
#     double_riichi (2) + pinfu (1) + tanyao (1) + ura:2 (88p) = 6 han (Haneman) -> Dealer ron = 18000!

[meta]
name: open_kan_discard_riichi_ron_ura
title: Post-open-kan riichi ron counts the second ura indicator on Tenhou but not Mahjong Soul default
rules: both
source: engine.md §4.2, rules.md §1, §4.17, §5.4
unverified: rules.md §5 item 4 (Mahjong Soul owed kan dora and matching ura on post-kan ron)

[round]
wind: E
round: 1
honba: 0
sticks: 0
dealer: 0
scores: 25000 25000 25000 25000

[wall]
hand 0: 234m 678m 234p 56s 88p
hand 1: 555z 147m 369p 148s 2z
hand 2: 258m 369p 147s 1236z
hand 3: 369m 147p 259s 2347z
dora: 1z 2z
ura: 1z 7p
rinshan: 7s
draws: 5z

[steps]
0 riichi
0 tsumogiri 5z
window: 1=daiminkan
1 tsumogiri 7s
assert_legal 0: ron
window: 0=ron

[expect.mahjongsoul]
outcome: ron
winners: 0
win 0: han=4 fu=30 yaku=double_riichi,pinfu,tanyao
deltas: 11600 -11600 0 0
scores: 36600 13400 25000 25000
sticks: 0
honba: 1
dealer_repeats: true
events: start_kyoku, tsumo(0), reach(0), dahai(0), reach_accepted(0), daiminkan(1), tsumo(1), dahai(1), hora(0), end_kyoku

[expect.tenhou]
outcome: ron
winners: 0
win 0: han=6 fu=30 yaku=double_riichi,pinfu,tanyao,ura:2
deltas: 18000 -18000 0 0
scores: 43000 7000 25000 25000
sticks: 0
honba: 1
dealer_repeats: true
events: start_kyoku, tsumo(0), reach(0), dahai(0), reach_accepted(0), daiminkan(1), tsumo(1), dahai(1), dora(2z), hora(0), end_kyoku
