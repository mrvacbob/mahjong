# Temporary furiten surviving a call (engine.md §4.1, rules.md §1 furiten_temporary, §4.28).
# NOTE: See scenarios/QUESTIONS.md! rules.md §1/§4.28 says "until own next draw/call" for
# Mahjong Soul while Tenhou explicitly says "a call in between does not clear it"
# (and engine.md §4.1 states a call does not end it for either). Per the brief, this
# scenario follows rules.md for each ruleset and flags the discrepancy in QUESTIONS.md.
#
# Setup: Seat 0 discards 2s -> Seat 1 pons 2s (using 22s), discards 9m.
# Seat 1 now holds 456p 567s 23m 88p + pon 222s (waiting 1m/4m; 4m is Tanyao).
# Seat 2 discards 4m -> Seat 1 passes ron -> temporary furiten!
# Seat 3 discards 8p -> Seat 1 calls pon:88p, discards 2m -> now waiting tanki on 3m (Tanyao).
# Seat 2 discards 3m (before Seat 1's next draw from the wall!).
# - Tenhou: temporary furiten SURVIVES the pon -> Seat 1 cannot ron 3m; later Seat 1 draws 3m and tsumos.
#   Fu: 20 base + 2 tsumo + 2 pon(2s) + 2 pon(8p) + 2 tanki(3m) = 28 -> 30 fu; 1 han (tanyao) -> 300/500 (+1100).
# - Mahjong Soul (per rules.md §1 text "draw/call"): call cleared temporary furiten -> Seat 1 rons 3m!
#   Fu: 20 base + 2 pon(2s) + 2 pon(8p) + 2 tanki(3m) = 26 -> 30 fu; 1 han (tanyao) -> 1000 from Seat 2.

[meta]
name: furiten_surviving_call
title: Whether temporary furiten survives a call before the seat's next draw
rules: both
source: engine.md §4.1, rules.md §1 (furiten_temporary), §4.28
unverified: rules.md §1 vs engine.md §4.1 discrepancy on Mahjong Soul call clearing temporary furiten

[round]
wind: E
round: 1
honba: 0
sticks: 0
dealer: 0
scores: 25000 25000 25000 25000

[wall]
hand 0: 2s 111p 999p 111s 999s
hand 1: 22s 456p 567s 23m 88p 9m
hand 2: 4m 3m 1199m 556p 334s 7z
hand 3: 8p 5566m 77p 9p 344s 6z 7z
dora: 1z
draws: 2z 2z 3z 3z 4z 4z 3m

[steps]
0 discard 2s
window: 1=pon:22s
1 discard 9m
2 discard 4m
assert_legal 1: ron
window: 1=pass
assert_furiten 1: true
3 discard 8p
window: 1=pon:88p
1 discard 2m
2 discard 3m

[steps.tenhou]
assert_furiten 1: true
assert_illegal 1: ron
assert_not_asked 1
3 tsumogiri 4z
0 tsumogiri 4z
assert_furiten 1: false
1 tsumo

[steps.mahjongsoul]
assert_furiten 1: false
assert_legal 1: ron
window: 1=ron

[expect.tenhou]
outcome: tsumo
winners: 1
win 1: han=1 fu=30 yaku=tanyao
deltas: -500 1100 -300 -300
scores: 24500 26100 24700 24700
sticks: 0
honba: 0
dealer_repeats: false
events_order: pon(1), dahai(2), pon(1), dahai(2), tsumo(1), hora(1), end_kyoku

[expect.mahjongsoul]
outcome: ron
winners: 1
win 1: han=1 fu=30 yaku=tanyao
deltas: 0 1000 -1000 0
scores: 25000 26000 24000 25000
sticks: 0
honba: 0
dealer_repeats: false
events_order: pon(1), dahai(2), pon(1), dahai(2), hora(1), end_kyoku
