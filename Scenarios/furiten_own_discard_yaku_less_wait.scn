# Own-discard furiten checks ALL waits, including yaku-less waits and discards that were called away
# (engine.md §4.1, rules.md §4.27).
# Seat 1 discards 1m on turn 1 (which Seat 2 calls with chi:23m!).
# Later Seat 1 calls chi on 6s (open hand: 23m 234p 567p 88p + chi 678s),
# waiting on 1m (no yaku) and 4m (tanyao).
# Because 1m is in Seat 1's own pond (even though called away!), Seat 1 is furiten
# and CANNOT ron Seat 0's discard of 4m; Seat 1 must win by tsumo!
# Scoring for Seat 1 (non-dealer, South):
#   Hand: 23m 234p 567p 88p + chi 678s + tsumo 4m (wait 1m/4m ryanmen; open hand)
#   Yaku: tanyao (1 han). Dora indicator 1z -> dora 2z (0 dora).
#   Fu: 20 base + 2 tsumo = 22 -> 30 fu (open pinfu-shape tsumo = 30 fu, rules.md §4.9).
#   Non-dealer tsumo 1 han 30 fu: 300 from non-dealers (Seats 2, 3), 500 from dealer (Seat 0).
#   Total to Seat 1: 300 + 300 + 500 = 1100.

[meta]
name: furiten_own_discard_yaku_less_wait
title: Own-discard furiten applies to yaku-less waits and called-away discards
rules: mahjongsoul
source: engine.md §4.1, rules.md §4.9, §4.27

[round]
wind: E
round: 1
honba: 0
sticks: 0
dealer: 0
scores: 25000 25000 25000 25000

[wall]
hand 0: 6s 4m 111p 999p 111s 99s
hand 1: 1m 23m 234p 567p 78s 88p
hand 2: 23m 1199m 556p 2233s
hand 3: 3344m 77p 9p 3344s 6z 7z
dora: 1z
draws: 2z 2z 2z 3z 3z 3z 4z 4m

[steps]
# Turn 1: Seat 0 tsumogiris; Seat 1 discards 1m -> Seat 2 calls chi:23m on 1m!
0 tsumogiri 2z
1 discard 1m
window: 2=chi:23m
2 discard 9m
3 tsumogiri 2z
# Turn 2: Seat 0 discards 6s -> Seat 1 calls chi:78s, discards 2z (completing open tenpai on 1m/4m).
0 discard 6s
window: 1=chi:78s
1 discard 2z
assert_furiten 1: true
2 tsumogiri 3z
3 tsumogiri 3z
# Turn 3: Seat 0 discards 4m -> Seat 1 is own-discard furiten (1m was discarded by Seat 1)
# so Seat 1 CANNOT ron 4m but can still chi.
0 discard 4m
assert_illegal 1: ron
assert_legal 1: chi:23m
window: 1=pass, 3=pass
1 tsumo

[expect]
outcome: tsumo
winners: 1
win 1: han=1 fu=30 yaku=tanyao
deltas: -500 1100 -300 -300
scores: 24500 26100 24700 24700
sticks: 0
honba: 0
dealer_repeats: false
events_order: dahai(1), chi(2), chi(1), dahai(0), tsumo(1), hora(1), end_kyoku
