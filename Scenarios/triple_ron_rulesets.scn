# Triple ron (Sanchahou) — ruleset difference (engine.md §4.1 row 1, §4.2, rules.md §1, §4.21).
# Round starts with honba=1 (300 on ron), sticks=1 (1000 on table), dealer=0.
# Seat 0 discards 7s; Seats 1, 2, 3 all answer ron!
# - Mahjong Soul: all 3 win! Closest CCW from discarder (Seat 1) gets honba + stick:
#   * Seat 1: pinfu + tanyao (2 han 30 fu) = 2000 + 300 (honba) + 1000 (stick) = +3300 (2300 from Seat 0)
#   * Seat 2: pinfu + tanyao (2 han 30 fu) = 2000 from Seat 0
#   * Seat 3: pinfu + tanyao (2 han 30 fu) = 2000 from Seat 0
#   * Seat 0 pays 2300 + 2000 + 2000 = 6300; dealer does not repeat; honba resets to 0.
# - Tenhou: abortive draw (sanchahou)! No points paid, stick stays, honba +1, dealer repeats.

[meta]
name: triple_ron_rulesets
title: Triple ron pays all three on Mahjong Soul and aborts (sanchahou) on Tenhou
rules: both
source: engine.md §4.1 row 1, §4.2, rules.md §1, §4.21; real-log campaign, Docs/Notes/p3-reallogs.md

[round]
wind: E
round: 1
honba: 1
sticks: 1
dealer: 0
scores: 25000 25000 25000 24000

[wall]
hand 0: 7s 1199m 1199p 1199s
hand 1: 234m 678m 234p 56s 88p
hand 2: 234m 567m 234p 56s 66p
hand 3: 345m 678m 345p 56s 77p
dora: 1z
draws: 2z

[steps]
0 discard 7s
assert_legal 1: ron
assert_legal 2: ron
assert_legal 3: ron
window: 1=ron, 2=ron, 3=ron

[expect.mahjongsoul]
outcome: ron
winners: 1, 2, 3
win 1: han=2 fu=30 yaku=pinfu,tanyao
win 2: han=2 fu=30 yaku=pinfu,tanyao
win 3: han=2 fu=30 yaku=pinfu,tanyao
deltas: -6300 3300 2000 2000
scores: 18700 28300 27000 26000
sticks: 0
honba: 0
dealer_repeats: false
events: start_kyoku, tsumo(0), dahai(0), hora(1), hora(2), hora(3), end_kyoku

[expect.tenhou]
outcome: abortive_draw
abort_reason: sanchahou
deltas: 0 0 0 0
scores: 25000 25000 25000 24000
sticks: 1
honba: 2
dealer_repeats: true
events: start_kyoku, tsumo(0), dahai(0), ryukyoku(sanchahou), end_kyoku
