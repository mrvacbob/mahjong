# Riichi ankan rule (rules.md §4.14, §5.3):
# - Only wait kinds are compared (decomposition may change).
# - Okurikan (kanning a quad that does not use the just-drawn tile) is always illegal.
# Seat 0 (riichi): 123456p 4445m 111z (waits 3m, 5m, 6m). Draws 4m -> ankan:4m ILLEGAL (waits shrink to 5m).
# Seat 1 (riichi): 23m 999p 33345666s (waits 1m, 4m). Draws 6s -> ankan:6s LEGAL (waits stay 1m, 4m).
# Seat 1 draws rinshan 1m and wins by tsumo!
# Scoring for Seat 1 (non-dealer, South):
#   123m 999p 33s 345s + closed kan 6666s. Only two concealed sets.
#   Double riichi (2) + menzen tsumo (1) + rinshan (1) = 4 han.
#   Dora 3z/6z and ura 5z/4z are absent. The kan cancels ippatsu.
#   20 base + 2 tsumo + 8 (terminal triplet) + 16 (simple closed kan)
#   = 46, rounded to 50 fu. Mangan base 2000: dealer pays 4000, others 2000.
#   Seat 0 pays 1000 riichi + 4000 tsumo. Seat 1 pays 1000 riichi,
#   receives 8000 tsumo + 2000 from the table, and nets 9000.

[meta]
name: riichi_ankan_waits
title: Riichi ankan compares only wait kinds and forbids wait-changing kan
rules: mahjongsoul
source: engine.md §4.2, rules.md §4.14, §5.3
unverified: rules.md §5 item 3 (resolved by published rules, not checked in a client)

[round]
wind: E
round: 1
honba: 0
sticks: 0
dealer: 0
scores: 25000 25000 25000 25000

[wall]
hand 0: 123456p 4445m 111z
hand 1: 23m 999p 33345666s
hand 2: 44z 137m 258p 147s 26z
hand 3: 77z 789m 147p 258s 25z
dora: 2z 5z
ura: 7z 3z
rinshan: 1m
draws: 4z 4z 7z 6z 4m 6s

[steps]
# Turn 1: Seat 0 and Seat 1 declare Double Riichi; Seats 2, 3 tsumogiri.
0 riichi
0 tsumogiri 4z
window: 2=pass
1 riichi
1 tsumogiri 4z
window: 2=pass
2 tsumogiri 7z
window: 3=pass
3 tsumogiri 6z
# Turn 2: Seat 0 draws 4th 4m -> ankan:4m would drop waits 3m and 6m -> ILLEGAL!
assert_illegal 0: ankan:4m
0 tsumogiri 4m
window: 1=pass
# Seat 1 draws 4th 6s -> ankan:6s keeps waits 1m/4m despite changing decomposition -> LEGAL!
assert_legal 1: ankan:6s
1 ankan 6s
1 tsumo

[expect]
outcome: tsumo
winners: 1
win 1: han=4 fu=50 yaku=double_riichi,rinshan,tsumo
deltas: -5000 9000 -2000 -2000
scores: 20000 34000 23000 23000
sticks: 0
honba: 0
dealer_repeats: false
events: start_kyoku, tsumo(0), reach(0), dahai(0), reach_accepted(0), tsumo(1), reach(1), dahai(1), reach_accepted(1), tsumo(2), dahai(2), tsumo(3), dahai(3), tsumo(0), dahai(0), tsumo(1), ankan(1), dora(5z), tsumo(1), hora(1), end_kyoku
