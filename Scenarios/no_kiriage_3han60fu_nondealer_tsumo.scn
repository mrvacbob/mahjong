# 9999m closed kan, 222m, 678p, 567s, 88p; the 7s is a replacement draw.
# Menzen tsumo, rinshan and one 7p dora (indicator 6p) give 3 han.
# The kan indicator 1z adds no dora. The kan interrupts the first go-around.
# 20 base + 2 tsumo + 32 terminal closed kan + 4 simple triplet
# = 58, rounded to 60 fu. Base 60 * 2^(3+2) = 1920 without kiriage.
# Dealer tsumo: round 3840 up to 3900 each, for 11700 total.
# Nondealer tsumo: round 3840 up to 3900 and each 1920 up to 2000,
# for 7900 total. Honba and sticks start at zero.

[meta]
