# Calling daiminkan on a riichi discard emits reach_accepted first and cancels ippatsu
# (engine.md §4.1 rows 3/6, §4.2, §6, rules.md §4.26).
# Seat 0 declares double riichi and discards 5z.
# Seat 1 calls daiminkan on 5z -> reach_accepted(0) precedes daiminkan(1), cancelling ippatsu.
# Seat 1 draws rinshan 7s and discards 7s -> Seat 0 rons 7s WITHOUT ippatsu!
# Scoring for Seat 0 (dealer, East):
#   Hand: 567m 234p 678p 56s 88m + ron 7s (dora ind 1z, 2z; ura 1z, 2z -> 0 dora)
#   Yaku: double_riichi (2) + pinfu (1) + tanyao (1) = 4 han 30 fu (NO ippatsu!)
#   Dealer 4 han 30 fu = 11600 (with ippatsu it would be 12000).
#   Seat 0 recovers its own 1000 stick: net deltas +11600 -11600 0 0.

[meta]
name: riichi_discard_daiminkan_cancels_ippatsu
title: Daiminkan on a riichi discard emits reach_accepted before daiminkan and cancels ippatsu
rules: mahjongsoul
source: engine.md §4.1 rows 3/6, §4.2, §6, rules.md §4.26, §5.4; real-log campaign, Docs/Notes/p3-reallogs.md

[round]
wind: E
round: 1
honba: 0
sticks: 0
dealer: 0
scores: 25000 25000 25000 25000

[wall]
hand 0: 567m 234p 678p 56s 88m
hand 1: 555z 147m 258p 369s 1z
hand 2: 258m 369p 147s 2346z
hand 3: 369m 147p 258s 1247z
dora: 1z 2z
ura: 1z 2z
rinshan: 7s
draws: 5z

[steps]
0 riichi
0 tsumogiri 5z
window: 1=daiminkan
1 tsumogiri 7s
assert_legal 0: ron
window: 0=ron

[expect]
outcome: ron
winners: 0
win 0: han=4 fu=30 yaku=double_riichi,pinfu,tanyao
deltas: 11600 -11600 0 0
scores: 36600 13400 25000 25000
sticks: 0
honba: 1
dealer_repeats: true
events: start_kyoku, tsumo(0), reach(0), dahai(0), reach_accepted(0), daiminkan(1), tsumo(1), dora(2z), dahai(1), hora(0), end_kyoku
