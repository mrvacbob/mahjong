# Legal robber passing an added kan lets the kan complete and triggers temporary furiten
# (engine.md §4.1 robbing window & furiten, §4.2, rules.md §4.28).
# Seat 0 discards 4m -> Seat 1 calls pon:44m (Seat 3 passes ron on 4m), discards 1z.
# Seat 2 tsumogiris 2z; Seat 3 (holding 23m 678m 234p 567s 88p, waiting 1m/4m) draws and tsumogiris 3z
# (clearing temporary furiten from the earlier 4m); Seat 0 tsumogiris 4z.
# Seat 1 draws 4th 4m and declares kakan 4m -> robbing window opens for Seat 3!
# Seat 3 has legal ron (Chankan + Pinfu + Tanyao) but explicitly answers pass:
#   - kakan completes (Seat 1 draws rinshan 9p),
#   - Seat 3 becomes temporarily furiten!
# Seat 1 discards 1m (Seat 3's other wait, Pinfu) -> Seat 3 is furiten and NOT asked (turn advances to Seat 2).
# Seat 2 tsumogiris 5z -> Seat 3 draws 1m -> temporary furiten clears on own draw -> Seat 3 wins by tsumo!
# Scoring for Seat 3 (non-dealer, North):
#   Hand: 23m 678m 234p 567s 88p + tsumo 1m (dora ind 1z, kan dora ind 3z -> 0 dora)
#   Yaku: tsumo (1) + pinfu (1) = 2 han 20 fu -> 400 / 700 (+1500).

[meta]
name: kakan_robbing_pass_furiten
title: Passing a legal kakan rob completes the kan and triggers temporary furiten until own draw
rules: mahjongsoul
source: engine.md §4.1, §4.2, rules.md §4.28; real-log campaign, Docs/Evidence/real-logs.md

[round]
wind: E
round: 1
honba: 0
sticks: 0
dealer: 0
scores: 25000 25000 25000 25000

[wall]
hand 0: 4m 147p 258s 1234z 7m 9m
hand 1: 44m 1m 1z 369p 147s 235z
hand 2: 369m 258p 369s 2467z
hand 3: 23m 678m 234p 567s 88p
dora: 1z 3z
rinshan: 9p
draws: 7z 2z 3z 4z 4m 5z 1m

[steps]
0 discard 4m
window: 1=pon:44m, 3=pass
1 discard 1z
2 tsumogiri 2z
3 tsumogiri 3z
0 tsumogiri 4z
assert_furiten 3: false
1 kakan 4m
assert_legal 3: ron
window: 3=pass
assert_furiten 3: true
1 discard 1m
assert_furiten 3: true
assert_illegal 3: ron
assert_not_asked 3
2 tsumogiri 5z
assert_furiten 3: false
3 tsumo

[expect]
outcome: tsumo
winners: 3
win 3: han=2 fu=20 yaku=pinfu,tsumo
deltas: -700 -400 -400 1500
scores: 24300 24600 24600 26500
sticks: 0
honba: 0
dealer_repeats: false
events: start_kyoku, tsumo(0), dahai(0), pon(1), dahai(1), tsumo(2), dahai(2), tsumo(3), dahai(3), tsumo(0), dahai(0), tsumo(1), kakan(1), tsumo(1), dora(3z), dahai(1), tsumo(2), dahai(2), tsumo(3), hora(3), end_kyoku
