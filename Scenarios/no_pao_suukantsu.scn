# No Pao on Suukantsu (engine.md §4.2, rules.md §1 pao_suukantsu, §4.32).
# Seat 1 makes 3 closed kans (1m, 9m, 1p), then Seat 0 discards 9p ->
# Seat 1 calls daiminkan on 9p (4th kan!), draws rinshan 2z (pair 22z) -> Tsumo: Suukantsu (1x Yakuman)!
# Because Suukantsu has NO pao, Seat 0 does NOT pay 100%; all 3 opponents pay normally:
# Non-dealer Yakuman tsumo = 16000 from dealer (Seat 0), 8000 from non-dealers (Seats 2, 3), +32000 to Seat 1.

[meta]
name: no_pao_suukantsu
title: Feeding the fourth kan for Suukantsu does not trigger Pao
rules: mahjongsoul
source: engine.md §4.2, rules.md §1 (pao_suukantsu), §4.32

[round]
wind: E
round: 1
honba: 0
sticks: 0
dealer: 0
scores: 25000 25000 25000 25000

[wall]
hand 0: 9p 234m 678m 234p 678p
hand 1: 1111m 9999m 1111p 9p
hand 2: 2233s 4455s 6677s 5z
hand 3: 4455m 5577p 8899s 6z
dora: 1z 3z 4z 7z 5z
rinshan: 9p 9p 2z 2z
draws: 3z 4z 3z 4z 7z

[steps]
0 tsumogiri 3z
1 ankan 1m
1 ankan 9m
1 ankan 1p
# Seat 1 now holds 9p 9p 9p 2z (from hand + 3 rinshan draws) plus 4z (live[1])!
1 discard 4z
2 tsumogiri 3z
3 tsumogiri 4z
0 discard 9p
# Seat 0 feeds the 4th kan (daiminkan 9p) -> NO Pao!
window: 1=daiminkan
1 tsumo

[expect]
outcome: tsumo
winners: 1
win 1: yakuman=1 yaku=suukantsu
deltas: -16000 32000 -8000 -8000
scores: 9000 57000 17000 17000
sticks: 0
honba: 0
dealer_repeats: false
events_order: ankan(1), ankan(1), ankan(1), dahai(0), daiminkan(1), tsumo(1), hora(1), end_kyoku
