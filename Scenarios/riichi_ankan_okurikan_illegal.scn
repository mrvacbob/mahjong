hand 1: 479m 159p 147s 1234z
hand 2: 58m 159p 258s 12356z
hand 3: 469m 149p 369s 2467z
dora: 1z
ura: 1z
draws: 9m 2z 3z 4z 9s 8p

[steps]
0 riichi
0 tsumogiri 9m
1 tsumogiri 2z
2 tsumogiri 3z
3 tsumogiri 4z
assert_illegal 0: ankan:1m
assert_illegal 0: ankan
0 tsumogiri 9s
1 tsumogiri 8p
assert_legal 0: ron
window: 0=ron

