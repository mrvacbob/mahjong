# Post-open-kan discard where window passes reveals the owed kan dora before next draw
# (engine.md §4.2 Kan transactions, rules.md §4.17).
# Seat 0 discards 5z -> Seat 1 calls daiminkan on 5z (owes kan dora 7p -> dora 8p).
# Seat 1 draws and discards rinshan 1z. Seat 3 can pon, but passes.
# Both rulesets reveal 7p immediately before Seat 1’s discard.
# Seat 2 draws 7s and wins by tsumo holding two 8p -> counts the new kan dora (+2)!
# Scoring for Seat 2 (non-dealer, West):
#   Hand: 234m 678m 234p 56s 88p + tsumo 7s (dora ind 1z, 7p -> dora 2z, 8p)
#   Yaku: tsumo (1) + pinfu (1) + tanyao (1) + dora:2 (88p) = 5 han (Mangan)
#   Non-dealer Mangan tsumo: 2000 / 4000 (+8000).

[meta]
name: open_kan_discard_all_pass_dora
title: Owed kan dora precedes the discard even when all players pass
rules: both
source: engine.md §4.2, rules.md §4.17, §5.4; real-log campaign, Docs/Evidence/real-logs.md

[round]
wind: E
round: 1
honba: 0
sticks: 0
dealer: 0
scores: 25000 25000 25000 25000

[wall]
hand 0: 5z 147m 259p 369s 234z
hand 1: 555z 147m 369p 148s 2z
hand 2: 234m 678m 234p 56s 88p
hand 3: 369m 147p 259s 1167z
dora: 1z 7p
rinshan: 1z
draws: 7z 7s

[steps]
0 discard 5z
window: 1=daiminkan
1 tsumogiri 1z
assert_legal 3: pon:11z
window: 3=pass
2 tsumo

[expect.mahjongsoul]
outcome: tsumo
winners: 2
win 2: han=5 fu=20 yaku=dora:2,pinfu,tanyao,tsumo
deltas: -4000 -2000 8000 -2000
scores: 21000 23000 33000 23000
sticks: 0
honba: 0
dealer_repeats: false
events: start_kyoku, tsumo(0), dahai(0), daiminkan(1), tsumo(1), dora(7p), dahai(1), tsumo(2), hora(2), end_kyoku

[expect.tenhou]
outcome: tsumo
winners: 2
win 2: han=5 fu=20 yaku=dora:2,pinfu,tanyao,tsumo
deltas: -4000 -2000 8000 -2000
scores: 21000 23000 33000 23000
sticks: 0
