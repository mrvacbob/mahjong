# Pao (liability) on Daisangen won by Tsumo (engine.md §4.2, rules.md §1, §4.31).
# Round starts with honba=1 (300 total on tsumo).
# Seat 1 pons 5z (from Seat 0), pons 6z (from Seat 0), then Seat 2 discards 7z ->
# Seat 1 pons 7z (3rd dragon set -> Seat 2 is liable for Pao on Daisangen!).
# Seat 1 draws 4m and wins by Tsumo (Daisangen, 1x Yakuman, non-dealer = 32000 + 300 honba).
# Liable seat (Seat 2) pays 100% of yakuman + honba = -32300; Seats 0 and 3 pay 0.

[meta]
name: pao_tsumo_daisangen
title: Pao on Daisangen won by tsumo makes the liable seat pay 100% plus honba
rules: mahjongsoul
source: engine.md §4.2, rules.md §1, §4.31

[round]
wind: E
round: 1
honba: 1
sticks: 0
dealer: 0
scores: 25000 25000 25000 25000

[wall]
hand 0: 5z 6z 111p 999p 111s 99s
hand 1: 55z 66z 77z 23m 88p 1z 9m 1s
hand 2: 7z 1199m 5566p 2233s
hand 3: 3344m 7744p 3344s 4z
dora: 1z
draws: 2z 2z 2z 3z 3z 3z 4z 4z 4m

[steps]
0 discard 5z
window: 1=pon:55z
1 discard 1z
2 tsumogiri 2z
3 tsumogiri 2z
0 discard 6z
window: 1=pon:66z
1 discard 9m
window: 2=pass
2 discard 7z
# Seat 2 feeds the 3rd dragon -> Pao on Daisangen against Seat 2!
window: 1=pon:77z
1 discard 1s
window: 0=pass, 2=pass
2 tsumogiri 3z
3 tsumogiri 4z
0 tsumogiri 4z
1 tsumo

[expect]
outcome: tsumo
winners: 1
win 1: yakuman=1 yaku=daisangen
deltas: 0 32300 -32300 0
scores: 25000 57300 -7300 25000
sticks: 0
honba: 0
dealer_repeats: false
events_order: pon(1), pon(1), pon(1), tsumo(1), hora(1), end_kyoku
